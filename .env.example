# BSG Carriers API — environment.
#
# LOCAL: copy this file to `.env` and fill it in. `.env` is gitignored and must
# never be committed or uploaded to the FTP web root.
#
# PRODUCTION (GoDaddy cPanel): do NOT upload a .env file. Set each of these in
# the cPanel "Setup Node.js App" > Environment Variables UI instead, so secrets
# live in the app config, not on disk in a browsable directory.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Passenger sets PORT in production; this is only used for local `npm start`.
PORT=4000
# Exact origin allowed to call the public API. No trailing slash.
ALLOWED_ORIGIN=http://localhost:5173

# --- Database (the fresh MySQL DB created in cPanel) -----------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tpvpzrbok576_bsgapi
DB_USER=tpvpzrbok576_bsgapi
DB_PASS=

# --- Sessions --------------------------------------------------------------
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Email notifications (cPanel SMTP) -------------------------------------
SMTP_HOST=mail.bsgcarriers.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@bsgcarriers.com
SMTP_PASS=
# Where new-lead emails are sent (the desk that watches for leads).
MAIL_TO=dispatch@bsgcarriers.com
# Envelope From — should match SMTP_USER for deliverability (SPF/DKIM).
MAIL_FROM=no-reply@bsgcarriers.com

# --- Slack notifications ---------------------------------------------------
# Incoming-webhook URL. Leave blank to disable Slack (email still fires).
SLACK_WEBHOOK_URL=

# --- Admin ------------------------------------------------------------------
# Public URL the admin dashboard is reached at, used in notification links.
ADMIN_URL=https://api.bsgcarriers.com/admin

# First admin account, seeded automatically on boot (idempotent). To reset a
# forgotten password, change ADMIN_PASSWORD and restart the app. Add more staff
# from inside the dashboard once you're in.
ADMIN_EMAIL=info@bsgcarriers.com
ADMIN_NAME=BSG Admin
ADMIN_PASSWORD=
