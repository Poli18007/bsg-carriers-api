<% var title=(board.name)+' board — BSG Carriers'; var active='board';
   function money(n){ return n==null?'':'$'+Number(n).toLocaleString(undefined,{minimumFractionDigits:0,maximumFractionDigits:0}); }
   function d(x){ return x?new Date(x).toLocaleDateString(undefined,{month:'short',day:'numeric'}):''; }
   function initials(n){ return (n||'').split(/\s+/).map(function(w){return w[0]||'';}).slice(0,2).join('').toUpperCase(); } %>
<%- include('partials/head', { title: title, active: active, wide: true }) %>

<div class="kbwrap">
  <div class="kbbar">
    <div class="tabs">
      <a class="tab active" href="/admin/board">Loads</a>
      <a class="tab" href="/admin/trailers">Trailers</a>
    </div>
    <div class="kbbar-actions">
      <a class="btn sm ghost" href="/admin/loads">Table view</a>
      <a class="btn sm ghost" href="/admin/boards/<%= board.id %>/columns">Edit columns</a>
      <a class="btn sm gold" href="/admin/loads/new">+ New load</a>
    </div>
  </div>

  <div class="kb">
    <% columns.forEach(function(col){ %>
      <div class="kb-col">
        <div class="kb-head">
          <span class="dot" style="background:<%= col.color||'#9a9ba3' %>"></span>
          <span class="kb-name"><%= col.name %></span>
          <span class="kb-count"><%= byCol[col.id].length %></span>
          <a class="kb-add" href="/admin/loads/new?column=<%= col.id %>" title="Add a load here">+</a>
        </div>
        <div class="kb-list" data-col="<%= col.id %>">
          <% byCol[col.id].forEach(function(l){ %>
            <a class="kb-card" draggable="true" data-id="<%= l.id %>" href="/admin/loads/<%= l.id %>" <% if(l.label_color){ %>style="border-left:3px solid <%= l.label_color %>"<% } %>>
              <div class="kb-top">
                <span class="kb-ref"><%= l.ref || ('#'+l.id) %></span>
                <% if(l.rate){ %><span class="kb-rate"><%= money(l.rate) %></span><% } %>
              </div>
              <% if(l.customer){ %><div class="kb-cust"><%= l.customer %></div><% } %>
              <div class="kb-lane"><span><%= l.origin || '—' %></span><i>→</i><span><%= l.destination || '—' %></span></div>
              <% if(l.label_name){ %><span class="kb-label" style="background:<%= (l.label_color||'#888') %>26;color:<%= l.label_color||'#9a9ba3' %>"><%= l.label_name %></span><% } %>
              <div class="kb-foot">
                <span class="kb-carrier"><%= l.carrier_name || 'Unassigned' %></span>
                <% if(l.truck_number){ %><span class="kb-chip">🚚 <%= l.truck_number %></span><% } %>
                <% if(l.trailer_number){ %><span class="kb-chip">📦 <%= l.trailer_number %></span><% } %>
                <% if(l.pickup_date){ %><span class="kb-date"><%= d(l.pickup_date) %></span><% } %>
                <% if(l.dispatcher_name){ %><span class="kb-av" title="<%= l.dispatcher_name %>"><%= initials(l.dispatcher_name) %></span><% } %>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    <% }) %>
    <a class="kb-newcol" href="/admin/boards/<%= board.id %>/columns">+ Column</a>
  </div>
</div>

<style>
  .kbwrap{display:flex;flex-direction:column;flex:1;min-height:0}
  .kbbar{display:flex;align-items:center;gap:14px;padding:12px 20px;border-bottom:1px solid var(--line);
         background:var(--panel);position:sticky;top:0;z-index:10;flex-wrap:wrap}
  .tabs{display:flex;gap:4px;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:3px}
  .tab{padding:6px 16px;border-radius:8px;color:var(--muted);font-weight:700;font-size:13px}
  .tab.active{background:var(--gold);color:#1a1400}
  .kbbar-actions{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}
  .kb{flex:1;min-height:0;display:flex;gap:14px;overflow-x:auto;overflow-y:hidden;padding:16px 20px 20px;align-items:stretch}
  .kb-col{width:272px;flex:0 0 272px;display:flex;flex-direction:column;background:var(--panel);
          border:1px solid var(--line);border-radius:12px;max-height:100%}
  .kb-head{display:flex;align-items:center;gap:8px;padding:11px 12px;border-bottom:1px solid var(--line-soft)}
  .kb-head .dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto}
  .kb-name{font-weight:700;font-size:13px;color:var(--heading);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .kb-count{color:var(--faint);font-size:12px;font-weight:700;background:var(--bg);padding:0 7px;border-radius:999px}
  .kb-add{margin-left:auto;color:var(--faint);font-size:18px;line-height:1;width:22px;height:22px;border-radius:6px;
          display:flex;align-items:center;justify-content:center}
  .kb-add:hover{background:var(--panel-2);color:var(--gold)}
  .kb-list{flex:1;overflow-y:auto;min-height:40px;display:flex;flex-direction:column;gap:9px;padding:10px}
  .kb-list.drag-over{background:var(--gold-soft);outline:1.5px dashed var(--gold);outline-offset:-4px;border-radius:8px}
  .kb-card{display:block;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:11px;
           text-decoration:none;color:var(--text);cursor:grab;transition:border-color .1s,transform .05s}
  .kb-card:hover{border-color:var(--gold)}
  .kb-card:active{transform:scale(.99)}
  .kb-card.dragging{opacity:.45}
  .kb-top{display:flex;justify-content:space-between;align-items:center;gap:8px}
  .kb-ref{font-weight:800;color:var(--heading)}
  .kb-rate{color:var(--gold);font-weight:800;font-size:13px}
  .kb-cust{font-size:12.5px;color:var(--text);margin-top:3px;font-weight:600}
  .kb-lane{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);margin-top:4px}
  .kb-lane i{color:var(--faint);font-style:normal}
  .kb-label{display:inline-block;margin-top:8px;padding:2px 8px;border-radius:6px;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.3px}
  .kb-foot{display:flex;align-items:center;gap:6px;margin-top:9px;flex-wrap:wrap}
  .kb-carrier{font-size:11.5px;color:var(--muted)}
  .kb-chip{font-size:10.5px;color:var(--muted);background:var(--panel-2);padding:1px 6px;border-radius:6px}
  .kb-date{font-size:10.5px;color:var(--faint);background:var(--panel-2);padding:1px 6px;border-radius:6px}
  .kb-av{margin-left:auto;width:22px;height:22px;border-radius:50%;background:var(--raise);color:var(--gold);
         font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center}
  .kb-newcol{flex:0 0 190px;align-self:flex-start;display:flex;align-items:center;justify-content:center;
             border:1.5px dashed var(--line);border-radius:12px;color:var(--muted);font-weight:600;padding:14px;height:52px}
  .kb-newcol:hover{border-color:var(--gold);color:var(--gold)}
</style>
<script>
  var CSRF = <%- JSON.stringify(csrfToken) %>;
  var dragId = null;
  document.querySelectorAll('.kb-card').forEach(function(card){
    card.addEventListener('dragstart', function(e){ dragId = card.dataset.id; card.classList.add('dragging'); e.dataTransfer.effectAllowed='move'; });
    card.addEventListener('dragend', function(){ card.classList.remove('dragging'); });
    card.addEventListener('click', function(e){ e.preventDefault(); if(card.classList.contains('dragging')) return; window.openCard(card.getAttribute('href')); });
  });
  document.querySelectorAll('.kb-list').forEach(function(list){
    list.addEventListener('dragover', function(e){ e.preventDefault(); list.classList.add('drag-over'); });
    list.addEventListener('dragleave', function(){ list.classList.remove('drag-over'); });
    list.addEventListener('drop', function(e){
      e.preventDefault(); list.classList.remove('drag-over');
      if(!dragId) return;
      var card = document.querySelector('.kb-card[data-id="'+dragId+'"]');
      var colId = list.dataset.col;
      if(card){ list.appendChild(card); recount(); }
      fetch('/admin/loads/'+dragId+'/column', {
        method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':CSRF,'X-Requested-With':'fetch'},
        body:'column_id='+encodeURIComponent(colId)
      }).catch(function(){ location.reload(); });
      dragId = null;
    });
  });
  function recount(){ document.querySelectorAll('.kb-col').forEach(function(col){ var c=col.querySelector('.kb-count'); if(c) c.textContent = col.querySelectorAll('.kb-card').length; }); }
</script>

<%- include('partials/card-modal') %>
<%- include('partials/foot') %>
