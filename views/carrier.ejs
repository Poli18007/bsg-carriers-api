<% var title='Carrier — ' + carrier.company_name; var active='carriers'; var c=carrier; %>
<%- include('partials/head', { title: title, active: active }) %>

<div style="display:flex;align-items:center;gap:12px;margin-bottom:6px">
  <a class="btn sm" href="/admin/carriers">← All carriers</a>
  <span class="tag <%= c.status %>"><%= c.status.replace('_',' ') %></span>
  <a class="btn sm gold" style="margin-left:auto" href="/admin/invoices/new?carrier=<%= c.id %>">Create invoice</a>
</div>
<h1><%= c.company_name %></h1>
<p class="sub">Registered <%= new Date(c.created_at).toLocaleString() %> · <%= c.email %></p>

<div class="panel" style="margin-bottom:18px">
  <dl class="dl">
    <dt>Contact</dt><dd><%= c.contact_name || '—' %></dd>
    <dt>Phone</dt><dd><% if (c.phone) { %><a href="tel:<%= c.phone.replace(/[^0-9+]/g,'') %>"><%= c.phone %></a><% } else { %>—<% } %></dd>
    <dt>Email</dt><dd><a href="mailto:<%= c.email %>"><%= c.email %></a></dd>
    <dt>MC number</dt><dd><%= c.mc_number || '—' %></dd>
    <dt>DOT number</dt><dd><%= c.dot_number || '—' %></dd>
    <dt>Equipment</dt><dd><%= c.equipment || '—' %></dd>
    <dt>Trucks</dt><dd><%= c.num_trucks || '—' %></dd>
    <dt>Preferred lanes</dt><dd><%= c.preferred_lanes || '—' %></dd>
    <dt>Location</dt><dd><%= c.current_location || '—' %></dd>
  </dl>
</div>

<h2 style="font-size:16px">Billing</h2>
<form method="post" action="/admin/carriers/<%= c.id %>/fee" class="panel" style="margin-bottom:18px;padding:16px;display:flex;gap:12px;align-items:end;flex-wrap:wrap">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field" style="margin:0;width:160px"><label>Default dispatch fee %</label><input name="dispatch_fee_pct" value="<%= c.dispatch_fee_pct!=null?c.dispatch_fee_pct:0 %>"></div>
  <button class="btn" type="submit">Save fee</button>
  <a class="btn gold" style="margin-left:auto" href="/admin/invoices/new?carrier=<%= c.id %>">Invoice this carrier →</a>
</form>

<% function dvi(x){ if(!x) return ''; var dt=new Date(x); return isNaN(dt)?'':dt.toISOString().slice(0,10); }
   function dsp(x){ return x? new Date(x).toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'}) : ''; }
   var DINP='background:var(--bg);border:1px solid var(--line);color:var(--text);padding:6px 9px;border-radius:8px;font:inherit'; %>
<h2 style="font-size:16px">Documents</h2>
<div class="panel" style="margin-bottom:18px;padding:4px 20px">
  <% if (!docs.length) { %><p class="muted" style="margin:12px 0">No documents uploaded yet.</p><% } %>
  <% docs.forEach(function(d){ %>
    <div style="padding:14px 0;border-bottom:1px solid var(--line-soft)">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <div style="min-width:0">
          <a href="/admin/carriers/<%= c.id %>/documents/<%= d.id %>" target="_blank"><%= d.filename %></a>
          <div class="muted" style="font-size:12px"><strong><%= d.doc_type %></strong> · <%= Math.round(d.size_bytes/1024) %> KB · uploaded <%= dsp(d.uploaded_at) %></div>
        </div>
        <div style="margin-left:auto;display:flex;gap:6px;align-items:center;flex-wrap:wrap">
          <% if (d.expired) { %><span class="tag needs_info">Expired <%= dsp(d.expires_at) %></span>
          <% } else if (d.expiring) { %><span class="tag pending">Expires <%= dsp(d.expires_at) %></span>
          <% } else if (d.expires_at) { %><span class="tag read">Valid to <%= dsp(d.expires_at) %></span>
          <% } else { %><span class="tag read" style="opacity:.7">No expiry set</span><% } %>
          <% if (d.renewal_requested_at) { %><span class="tag under_review">Renewal requested</span><% } %>
          <span class="tag <%= d.review %>"><%= d.review %></span>
        </div>
      </div>
      <% if (canApprove) { %>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:10px">
        <form method="post" action="/admin/carriers/<%= c.id %>/documents/<%= d.id %>/review" style="margin:0;display:flex;gap:6px">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn sm" name="review" value="accepted" <%= d.review==='accepted'?'disabled':'' %>>Accept</button>
          <button class="btn sm" name="review" value="rejected" <%= d.review==='rejected'?'disabled':'' %>>Reject</button>
        </form>
        <form method="post" action="/admin/carriers/<%= c.id %>/documents/<%= d.id %>/expiry" style="margin:0;display:flex;gap:6px;align-items:center">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="muted" style="font-size:12px">Expiry</label>
          <input type="date" name="expires_at" value="<%= dvi(d.expires_at) %>" style="<%= DINP %>">
          <button class="btn sm" type="submit">Save</button>
        </form>
        <% if (d.review === 'accepted') { %>
        <form method="post" action="/admin/carriers/<%= c.id %>/documents/<%= d.id %>/rerequest" style="margin:0" onsubmit="return confirm('Ask the carrier to upload a fresh <%= d.doc_type %>? They will get an email.')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn sm gold" type="submit">Request again</button>
        </form>
        <% } %>
      </div>
      <% } %>
    </div>
  <% }) %>
</div>

<h2 style="font-size:16px">Drivers</h2>
<div class="panel" style="margin-bottom:18px">
  <% if (!drivers.length) { %><p class="muted" style="margin:0 0 12px">No drivers yet.</p><% } %>
  <% drivers.forEach(function(d){ %>
    <div style="display:flex;align-items:center;gap:12px;padding:9px 0;border-bottom:1px solid var(--line);<%= d.active?'':'opacity:.5' %>">
      <div><strong><%= d.name %></strong><% if(!d.active){ %> <span class="muted">(inactive)</span><% } %>
        <div class="muted" style="font-size:12px">
          <% if(d.phone){ %><a href="tel:<%= d.phone.replace(/[^0-9+]/g,'') %>"><%= d.phone %></a><% } %>
          <% if(d.email){ %> · <%= d.email %><% } %>
          <% if(d.cdl_number){ %> · CDL <%= d.cdl_number %><%= d.cdl_state?' ('+d.cdl_state+')':'' %><% } %>
        </div></div>
      <form method="post" action="/admin/drivers/<%= d.id %>/app-password" style="margin:0 0 0 auto;display:flex;gap:6px;align-items:center" title="Set this driver's password for the mobile app">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="password" placeholder="app password" style="width:120px;background:var(--bg);border:1px solid var(--line);color:var(--text);padding:6px 8px;border-radius:7px;font-size:12px">
        <button class="btn sm" type="submit"><%= d.password_hash?'Reset':'Set' %> app login</button>
      </form>
      <form method="post" action="/admin/drivers/<%= d.id %>/remove" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn sm" type="submit"><%= d.active?'Deactivate':'Reactivate' %></button></form>
    </div>
  <% }) %>
  <form method="post" action="/admin/carriers/<%= c.id %>/drivers" style="display:grid;grid-template-columns:1.4fr 1fr 1.4fr .8fr .5fr auto;gap:8px;align-items:end;margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field" style="margin:0"><label>Driver name</label><input name="name" required></div>
    <div class="field" style="margin:0"><label>Phone</label><input name="phone"></div>
    <div class="field" style="margin:0"><label>Email</label><input name="email"></div>
    <div class="field" style="margin:0"><label>CDL #</label><input name="cdl_number"></div>
    <div class="field" style="margin:0"><label>State</label><input name="cdl_state"></div>
    <button class="btn sm gold" type="submit">Add</button>
  </form>
</div>

<h2 style="font-size:16px">Onboarding status</h2>
<% if (canApprove) { %>
<form method="post" action="/admin/carriers/<%= c.id %>/status" class="panel" style="max-width:620px">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field">
    <label>Status (emails the carrier when changed)</label>
    <select name="status">
      <% statuses.forEach(function(s){ %><option value="<%= s %>" <%= c.status===s?'selected':'' %>><%= s.replace('_',' ') %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label>Staff notes (included in the carrier email)</label>
    <input name="staff_notes" value="<%= c.staff_notes || '' %>" placeholder="e.g. COI expires next month — please send an updated copy.">
  </div>
  <button class="btn gold" type="submit">Update &amp; notify carrier</button>
</form>
<% } else { %>
<div class="panel" style="max-width:620px">
  <dl class="dl" style="margin:0">
    <dt>Status</dt><dd><span class="tag <%= c.status %>"><%= c.status.replace('_',' ') %></span></dd>
    <dt>Staff notes</dt><dd><%= c.staff_notes || '—' %></dd>
  </dl>
  <p class="muted" style="font-size:12px;margin:12px 0 0">Carrier approvals are handled by an admin or manager.</p>
</div>
<% } %>

<%- include('partials/foot') %>
