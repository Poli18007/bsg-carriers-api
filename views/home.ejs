<% var title='Dashboard — BSG Carriers'; var active='home';
   function money(n){ return n==null?'$0':'$'+Number(n).toLocaleString(undefined,{minimumFractionDigits:0,maximumFractionDigits:0}); }
   function when(x){ return x? new Date(x).toLocaleString(undefined,{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) : ''; } %>
<%- include('partials/head', { title: title, active: active }) %>

<div class="page-head">
  <h1>Dashboard</h1>
  <div class="spacer" style="display:flex;gap:8px">
    <a class="btn ghost" href="/admin/board">Open board</a>
    <a class="btn gold" href="/admin/loads/new">+ New load</a>
  </div>
</div>
<p class="sub">Welcome back, <%= user.name.split(' ')[0] %>. Here's where dispatch stands today.</p>

<div class="kpis">
  <div class="kpi accent"><div class="n"><%= loadCounts.active %></div><div class="l">Active loads</div></div>
  <div class="kpi"><div class="n"><%= money(loadCounts.active_rate) %></div><div class="l">Active revenue</div></div>
  <div class="kpi"><div class="n"><%= loadCounts.in_transit %></div><div class="l">In transit</div></div>
  <div class="kpi"><div class="n"><%= loadCounts.delivered %></div><div class="l">Delivered</div></div>
  <div class="kpi"><div class="n"><%= fleet.trucks %></div><div class="l">Trucks in service</div></div>
  <div class="kpi"><div class="n"><%= fleet.trailers %></div><div class="l">Trailers</div></div>
  <div class="kpi"><div class="n"><%= carrierCounts.total %></div><div class="l">Carriers<% if(carrierCounts.pending){ %> · <%= carrierCounts.pending %> pending<% } %></div></div>
  <div class="kpi"><div class="n"><%= fleet.new_leads %></div><div class="l">New leads</div></div>
</div>

<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:18px;align-items:start">
  <div>
    <h2 style="font-size:15px;margin:6px 0 10px">Loads by column</h2>
    <a href="/admin/board" style="text-decoration:none">
      <div class="minicols">
        <% columns.forEach(function(c){ %>
          <div class="minicol">
            <div class="mc-top"><span class="dot" style="background:<%= c.color||'#9a9ba3' %>"></span><span class="mc-n"><%= c.n %></span></div>
            <div class="mc-name"><%= c.name %></div>
          </div>
        <% }) %>
      </div>
    </a>

    <h2 style="font-size:15px;margin:22px 0 10px">Recent loads</h2>
    <div class="panel">
      <table>
        <thead><tr><th>Ref</th><th>Customer / Lane</th><th>Column</th><th>Rate</th></tr></thead>
        <tbody>
          <% if(!recentLoads.length){ %><tr><td colspan="4" class="muted" style="padding:24px;text-align:center">No loads yet. <a href="/admin/loads/new">Book one</a>.</td></tr><% } %>
          <% recentLoads.forEach(function(l){ %>
            <tr class="row" onclick="location.href='/admin/loads/<%= l.id %>'">
              <td><strong><%= l.ref||('#'+l.id) %></strong></td>
              <td><% if(l.customer){ %><%= l.customer %><br><% } %><span class="muted"><%= l.origin||'—' %> → <%= l.destination||'—' %></span></td>
              <td><% if(l.col_name){ %><span class="tag" style="background:<%= (l.col_color||'#888') %>26;color:<%= l.col_color||'#9a9ba3' %>"><%= l.col_name %></span><% } %></td>
              <td><%= money(l.rate) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div>
    <h2 style="font-size:15px;margin:6px 0 10px">Activity</h2>
    <div class="panel" style="padding:8px 16px">
      <% if(!activity.length){ %><p class="muted" style="padding:14px 0;margin:0">Nothing yet.</p><% } %>
      <% activity.forEach(function(a){ %>
        <div class="feed">
          <span class="tag <%= a.kind==='status'?'dispatched':(a.kind==='check_call'?'booked':'read') %>"><%= a.kind.replace('_',' ') %></span>
          <div class="feed-b">
            <div><a href="/admin/loads/<%= a.load_id %>"><%= a.ref||('#'+a.load_id) %></a> — <%= a.body %></div>
            <div class="muted" style="font-size:11.5px"><%= when(a.created_at) %><% if(a.staff_email){ %> · <%= a.staff_email %><% } %></div>
          </div>
        </div>
      <% }) %>
    </div>
    <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">
      <a class="btn sm" href="/admin/trucks/new">+ Truck</a>
      <a class="btn sm" href="/admin/trailers/new">+ Trailer</a>
      <a class="btn sm" href="/admin/customers/new">+ Customer</a>
      <a class="btn sm" href="/admin/carriers">Carriers</a>
    </div>
  </div>
</div>

<style>
  .minicols{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px}
  .minicol{flex:0 0 108px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:11px 12px;box-shadow:var(--shadow)}
  .minicol .mc-top{display:flex;align-items:center;justify-content:space-between}
  .minicol .dot{width:9px;height:9px;border-radius:50%}
  .minicol .mc-n{font-size:20px;font-weight:800;color:var(--heading)}
  .minicol .mc-name{color:var(--muted);font-size:11.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .feed{display:flex;gap:11px;padding:11px 0;border-bottom:1px solid var(--line-soft)}
  .feed:last-child{border-bottom:0}
  .feed .tag{height:fit-content;white-space:nowrap}
  .feed-b{min-width:0}
  @media(max-width:860px){ div[style*="grid-template-columns:1.4fr"]{grid-template-columns:1fr !important} }
</style>

<%- include('partials/foot') %>
