<%
  function money(n){ return '$'+Number(n||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }
  function d(x){ return x?new Date(x).toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'}):'—'; }
%><!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Invoice BSG-<%= inv.seq %></title>
<style>
  :root{--gold:#b8912f;--ink:#1a1a1a;--muted:#6b6b6b;--line:#e2e2e2}
  *{box-sizing:border-box}
  body{margin:0;background:#f3f3f3;color:var(--ink);font:14px/1.55 -apple-system,Segoe UI,Roboto,Arial,sans-serif}
  .sheet{max-width:800px;margin:24px auto;background:#fff;padding:44px 48px;box-shadow:0 2px 14px rgba(0,0,0,.12)}
  .top{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid var(--gold);padding-bottom:20px}
  .brand{font-size:22px;font-weight:800;letter-spacing:.5px}
  .brand b{color:var(--gold)}
  .brand .tag{display:block;font-size:12px;color:var(--muted);font-weight:600;letter-spacing:.3px;margin-top:2px}
  .inv-meta{text-align:right}
  .inv-meta .big{font-size:24px;font-weight:800;color:var(--gold)}
  .inv-meta div{font-size:13px;color:var(--muted)}
  .parties{display:flex;justify-content:space-between;margin:26px 0}
  .parties .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin-bottom:5px}
  .parties .val{font-weight:700}
  table{width:100%;border-collapse:collapse;margin-top:10px}
  th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:2px solid var(--line);padding:8px 6px}
  td{padding:10px 6px;border-bottom:1px solid var(--line)}
  td.r,th.r{text-align:right}
  .totals{margin-top:16px;margin-left:auto;width:280px}
  .totals .row{display:flex;justify-content:space-between;padding:5px 0}
  .totals .bal{border-top:2px solid var(--gold);margin-top:6px;padding-top:10px;font-size:18px;font-weight:800;color:var(--gold)}
  .status{display:inline-block;padding:3px 12px;border-radius:999px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;border:1px solid var(--gold);color:var(--gold)}
  .notes{margin-top:30px;color:var(--muted);font-size:13px;border-top:1px solid var(--line);padding-top:14px}
  .actions{max-width:800px;margin:0 auto 30px;text-align:right}
  .btn{display:inline-block;background:var(--gold);color:#fff;border:0;padding:10px 18px;border-radius:8px;font-weight:700;cursor:pointer;text-decoration:none;font-size:14px}
  @media print{ body{background:#fff} .sheet{box-shadow:none;margin:0;max-width:none} .actions{display:none} }
</style>
</head>
<body>
<div class="actions"><button class="btn" onclick="window.print()">Print / Save as PDF</button></div>
<div class="sheet">
  <div class="top">
    <div class="brand"><img src="/brand/logo-dark.png" alt="BSG Carriers" style="height:52px;width:auto;display:block"><span class="tag" style="display:block;margin-top:4px">Truck Dispatching Services</span></div>
    <div class="inv-meta">
      <div class="big">INVOICE</div>
      <div><strong>BSG-<%= inv.seq %></strong></div>
      <div>Issued <%= d(inv.issue_date) %></div>
      <% if(inv.due_date){ %><div>Due <%= d(inv.due_date) %></div><% } %>
      <div style="margin-top:6px"><span class="status"><%= inv.status %></span></div>
    </div>
  </div>

  <div class="parties">
    <div>
      <div class="lbl">Bill to</div>
      <div class="val"><%= inv.carrier_name || inv.bill_to || '—' %></div>
      <% if(inv.carrier_contact){ %><div><%= inv.carrier_contact %></div><% } %>
      <% if(inv.carrier_email){ %><div><%= inv.carrier_email %></div><% } %>
      <% if(inv.mc_number){ %><div>MC <%= inv.mc_number %></div><% } %>
    </div>
    <div style="text-align:right">
      <div class="lbl">From</div>
      <div class="val">BSG Carriers</div>
      <div>info@bsgcarriers.com</div>
    </div>
  </div>

  <table>
    <thead><tr><th>Description</th><th class="r">Amount</th></tr></thead>
    <tbody>
      <% lines.forEach(function(li){ %><tr><td><%= li.description %></td><td class="r"><%= money(li.amount) %></td></tr><% }) %>
      <% if(!lines.length){ %><tr><td colspan="2" style="color:var(--muted);text-align:center;padding:18px">No line items.</td></tr><% } %>
    </tbody>
  </table>

  <div class="totals">
    <div class="row"><span>Subtotal</span><span><%= money(t.total) %></span></div>
    <div class="row"><span>Paid</span><span><%= money(t.paid) %></span></div>
    <div class="row bal"><span>Balance due</span><span><%= money(t.balance) %></span></div>
  </div>

  <% if(inv.notes){ %><div class="notes"><%= inv.notes %></div><% } %>
  <div class="notes">Thank you for partnering with BSG Carriers. Please remit payment to the account on file by the due date.</div>
</div>
</body>
</html>
