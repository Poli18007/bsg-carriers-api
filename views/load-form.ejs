<% var title=(isNew?'New load':'Load '+(load.ref||('#'+load.id)))+' — BSG Carriers'; var active='loads'; var l=load||{};
   function dv(x){ if(!x) return ''; var d=new Date(x); return isNaN(d)?'':d.toISOString().slice(0,10); }
   function money(n){ return n==null?'—':'$'+Number(n).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }
   function when(x){ return x? new Date(x).toLocaleString() : ''; } %>
<%- include('partials/head', { title: title, active: active }) %>

<div class="page-head">
  <a class="btn sm ghost" href="<%= isNew ? '/admin/loads' : '/admin/loads/' + l.id %>">← Back</a>
  <h1 style="margin-left:4px"><%= isNew ? 'Book a load' : ('Edit ' + (l.ref || ('#' + l.id))) %></h1>
</div>
<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>

<form method="post" action="<%= isNew ? '/admin/loads' : '/admin/loads/' + l.id %>" class="panel" style="max-width:900px">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px">
    <div class="field"><label>Reference / load #</label><input name="ref" value="<%= l.ref||'' %>"></div>
    <div class="field"><label>PU # (pickup number)</label><input name="pu_number" value="<%= l.pu_number||'' %>"></div>
    <div class="field"><label>Customer</label><select name="customer_id"><option value="">— pick a customer —</option><% customers.forEach(function(cu){ %><option value="<%= cu.id %>" <%= String(l.customer_id)===String(cu.id)?'selected':'' %>><%= cu.name %></option><% }) %></select></div>
    <div class="field"><label>Customer (one-off text)</label><input name="customer" value="<%= l.customer||'' %>" placeholder="or type a shipper"></div>
    <div class="field"><label>Column</label><select name="column_id"><% columns.forEach(function(col){ %><option value="<%= col.id %>" <%= String(l.column_id)===String(col.id)?'selected':'' %>><%= col.name %></option><% }) %></select></div>
    <div class="field"><label>Label</label><select name="label_id"><option value="">— none —</option><% labels.forEach(function(lb){ %><option value="<%= lb.id %>" <%= String(l.label_id)===String(lb.id)?'selected':'' %>><%= lb.name %></option><% }) %></select></div>
    <div class="field"><label>Dispatcher</label><select name="dispatcher_id"><option value="">— none —</option><% dispatchers.forEach(function(u){ %><option value="<%= u.id %>" <%= String(l.dispatcher_id)===String(u.id)?'selected':'' %>><%= u.name %></option><% }) %></select></div>
    <div class="field"><label>Broker</label><select name="broker_id"><option value="">— none —</option><% brokers.forEach(function(b){ %><option value="<%= b.id %>" <%= String(l.broker_id)===String(b.id)?'selected':'' %>><%= b.name %></option><% }) %></select></div>
    <div class="field"><label>Carrier</label><select name="carrier_id"><option value="">— unassigned —</option><% carriers.forEach(function(c){ %><option value="<%= c.id %>" <%= String(l.carrier_id)===String(c.id)?'selected':'' %>><%= c.company_name %></option><% }) %></select></div>
    <div class="field"><label>Driver</label><select name="driver_id"><option value="">— none —</option><% drivers.forEach(function(dr){ %><option value="<%= dr.id %>" <%= String(l.driver_id)===String(dr.id)?'selected':'' %>><%= dr.name %> — <%= dr.company_name %></option><% }) %></select></div>
    <div class="field"><label>Truck</label><select name="truck_id"><option value="">— none —</option><% trucks.forEach(function(tk){ %><option value="<%= tk.id %>" <%= String(l.truck_id)===String(tk.id)?'selected':'' %>><%= tk.number %></option><% }) %></select></div>
    <div class="field"><label>Trailer</label><select name="trailer_id"><option value="">— none —</option><% trailers.forEach(function(tr){ %><option value="<%= tr.id %>" <%= String(l.trailer_id)===String(tr.id)?'selected':'' %>><%= tr.number %></option><% }) %></select></div>
    <div class="field"><label>Trip</label><select name="trip_id"><option value="">— none —</option><% trips.forEach(function(tp){ %><option value="<%= tp.id %>" <%= String(l.trip_id)===String(tp.id)?'selected':'' %>>TRIP-<%= tp.seq %><%= tp.name?(' · '+tp.name):'' %></option><% }) %></select></div>
    <div class="field"><label>Miles</label><input name="miles" value="<%= l.miles!=null?l.miles:'' %>"></div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:6px">
    <div>
      <h2 style="font-size:14px;color:var(--gold);margin:6px 0 10px">PICKUP</h2>
      <div class="field"><label>Facility</label><input name="pickup_name" value="<%= l.pickup_name||'' %>"></div>
      <div class="field"><label>Address</label><input name="pickup_address" value="<%= l.pickup_address||'' %>"></div>
      <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px">
        <div class="field"><label>City</label><input name="pickup_city" value="<%= l.pickup_city||'' %>"></div>
        <div class="field"><label>State</label><input name="pickup_state" value="<%= l.pickup_state||'' %>"></div>
        <div class="field"><label>ZIP</label><input name="pickup_zip" value="<%= l.pickup_zip||'' %>"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div class="field"><label>Appointment</label><input name="pickup_appt" value="<%= l.pickup_appt||'' %>" placeholder="Sep 2, 08:00–12:00"></div>
        <div class="field"><label>Pickup # / PO</label><input name="pickup_ref" value="<%= l.pickup_ref||'' %>"></div>
      </div>
      <div class="field"><label>Instructions</label><input name="pickup_instructions" value="<%= l.pickup_instructions||'' %>"></div>
    </div>
    <div>
      <h2 style="font-size:14px;color:var(--gold);margin:6px 0 10px">DELIVERY</h2>
      <div class="field"><label>Facility</label><input name="delivery_name" value="<%= l.delivery_name||'' %>"></div>
      <div class="field"><label>Address</label><input name="delivery_address" value="<%= l.delivery_address||'' %>"></div>
      <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px">
        <div class="field"><label>City</label><input name="delivery_city" value="<%= l.delivery_city||'' %>"></div>
        <div class="field"><label>State</label><input name="delivery_state" value="<%= l.delivery_state||'' %>"></div>
        <div class="field"><label>ZIP</label><input name="delivery_zip" value="<%= l.delivery_zip||'' %>"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div class="field"><label>Appointment</label><input name="delivery_appt" value="<%= l.delivery_appt||'' %>" placeholder="Sep 4, 07:00"></div>
        <div class="field"><label>Delivery # / PO</label><input name="delivery_ref" value="<%= l.delivery_ref||'' %>"></div>
      </div>
      <div class="field"><label>Instructions</label><input name="delivery_instructions" value="<%= l.delivery_instructions||'' %>"></div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:14px;margin-top:6px">
    <div class="field"><label>Commodity</label><input name="commodity" value="<%= l.commodity||'' %>"></div>
    <div class="field"><label>Weight</label><input name="weight" value="<%= l.weight||'' %>"></div>
    <div class="field"><label>Equipment</label><input name="equipment" value="<%= l.equipment||'' %>"></div>
    <div class="field"><label>Rate (linehaul)</label><input name="rate" value="<%= l.rate!=null?l.rate:'' %>"></div>
  </div>
  <div class="field"><label>Notes</label><input name="notes" value="<%= l.notes||'' %>"></div>
  <button class="btn gold" type="submit"><%= isNew ? 'Book load' : 'Save changes' %></button>
</form>

<%- include('partials/foot') %>
