<% var title='Dashboard — BSG Carriers'; var active='home';
   function money(n){ return n==null?'$0':'$'+Number(n).toLocaleString(undefined,{minimumFractionDigits:0,maximumFractionDigits:0}); }
   function day(x){ return x? new Date(x).toLocaleDateString(undefined,{month:'short',day:'numeric'}) : '—'; }
   function catTag(c){ return c==='in_transit'?'in_transit':(c==='delivered'||c==='done'?'delivered':(c==='active'?'booked':'available')); } %>
<%- include('head', { title: title, active: active }) %>

<% if (notice) { %><div class="notice"><%= notice %></div><% } %>
<% if (error) { %><div class="error"><%= error %></div><% } %>

<div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
  <h1 style="margin-bottom:2px">Welcome back, <%= carrier.company_name %></h1>
  <span class="status approved">Approved</span>
</div>
<p class="sub">Here's a snapshot of your loads and account with BSG Carriers.</p>

<% if (renewals && renewals.length) { %>
<div class="notice" style="border-color:var(--warn)">
  📄 We've asked you to send an updated <strong><%= renewals.join(', ') %></strong>.
  <a href="/portal/documents" style="text-decoration:underline">Upload a current copy →</a>
</div>
<% } %>
<% if (docsExpiring && docsExpiring.length) { %>
<div class="notice">
  ⏳ Your <strong><%= docsExpiring.join(', ') %></strong> <%= docsExpiring.length>1?'are':'is' %> expiring soon — please send an updated copy so your loads aren't held up.
</div>
<% } %>

<div class="kpis">
  <div class="kpi accent"><div class="n"><%= stats.active %></div><div class="l">Active loads</div></div>
  <div class="kpi"><div class="n"><%= stats.in_transit %></div><div class="l">In transit</div></div>
  <div class="kpi"><div class="n"><%= stats.delivered %></div><div class="l">Delivered</div></div>
  <div class="kpi"><div class="n"><%= money(stats.active_value) %></div><div class="l">Active load value</div></div>
  <div class="kpi <%= stats.outstanding>0?'accent':'' %>"><div class="n"><%= money(stats.outstanding) %></div><div class="l">Balance due</div></div>
  <div class="kpi"><div class="n"><%= stats.total %></div><div class="l">Total loads</div></div>
</div>

<div class="grid" style="grid-template-columns:1.5fr 1fr;align-items:start;gap:18px">
  <div>
    <div style="display:flex;align-items:baseline;justify-content:space-between;margin:4px 0 10px">
      <h2 style="margin:0">Your loads</h2>
      <a href="/portal/loads" style="font-size:13px">View all →</a>
    </div>
    <div class="panel" style="padding:0">
      <% if (!upcoming.length) { %>
        <p class="muted" style="padding:22px;text-align:center;margin:0">No loads assigned yet. Your dispatcher will post them here as they're booked.</p>
      <% } else { %>
      <table style="width:100%;border-collapse:collapse">
        <thead><tr>
          <th style="text-align:left;padding:11px 15px;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:1px solid var(--line)">Load</th>
          <th style="text-align:left;padding:11px 15px;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:1px solid var(--line)">Lane</th>
          <th style="text-align:left;padding:11px 15px;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:1px solid var(--line)">Pickup</th>
          <th style="text-align:left;padding:11px 15px;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:1px solid var(--line)">Status</th>
          <th style="text-align:right;padding:11px 15px;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:1px solid var(--line)">Rate</th>
        </tr></thead>
        <tbody>
          <% upcoming.forEach(function(l){ %>
          <tr style="cursor:pointer" onclick="location.href='/portal/loads/<%= l.id %>'" onmouseover="this.style.background='var(--panel)'" onmouseout="this.style.background=''">
            <td style="padding:12px 15px;border-bottom:1px solid var(--line)"><strong><%= l.ref||('#'+l.id) %></strong></td>
            <td style="padding:12px 15px;border-bottom:1px solid var(--line)"><%= l.origin||'—' %> <span class="muted">→</span> <%= l.destination||'—' %></td>
            <td style="padding:12px 15px;border-bottom:1px solid var(--line)" class="muted"><%= day(l.pickup_date) %></td>
            <td style="padding:12px 15px;border-bottom:1px solid var(--line)"><span class="status <%= catTag(l.category) %>"><%= l.col_name || l.status %></span></td>
            <td style="padding:12px 15px;border-bottom:1px solid var(--line);text-align:right"><%= money(l.rate) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <div>
    <h2 style="margin:4px 0 10px">Account</h2>
    <div class="panel">
      <div class="doc" style="border:0;padding:6px 0">
        <div><div class="name">Documents</div><div class="meta"><%= docsApproved %> of <%= docsTotal %> approved<%= docsExpiring.length?(' · '+docsExpiring.length+' expiring'):'' %></div></div>
        <a class="btn sm" style="margin-left:auto" href="/portal/documents">Manage</a>
      </div>
      <div class="doc" style="padding:12px 0">
        <div><div class="name">Invoices</div><div class="meta"><%= stats.outstanding>0? (money(stats.outstanding)+' outstanding') : 'All settled' %></div></div>
        <a class="btn sm" style="margin-left:auto" href="/portal/invoices">View</a>
      </div>
      <div class="doc" style="border:0;padding:12px 0 6px">
        <div><div class="name">Profile</div><div class="meta">MC <%= carrier.mc_number||'—' %> · <%= carrier.equipment||'equipment n/a' %></div></div>
        <a class="btn sm" style="margin-left:auto" href="/portal/profile">Edit</a>
      </div>
    </div>
    <p class="muted" style="font-size:12px;margin-top:12px">Questions about a load or payment? Reply to any BSG email or call your dispatcher.</p>
  </div>
</div>

<%- include('foot') %>
