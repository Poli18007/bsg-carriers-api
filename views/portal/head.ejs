<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= typeof title !== 'undefined' ? title : 'BSG Carriers — Carrier Portal' %></title>
<link rel="icon" type="image/png" href="/brand/favicon.png">
<link rel="apple-touch-icon" href="/brand/favicon.png">
<style>
  :root{--black:#0b0b0c;--panel:#15161a;--line:#26272e;--gold:#DCB555;--gold-600:#c39f43;--gold-btn:#DCB555;
    --text:#e9e9ec;--muted:#9a9ba3;--bg:#0e0f12;--danger:#e05555;--ok:#DCB555;--info:#7fb0e0;--warn:#e0b060;}
  :root[data-theme="light"]{--black:#ffffff;--panel:#ffffff;--line:#e4e6ea;--gold:#8a6712;--gold-600:#c39f43;--gold-btn:#DCB555;
    --text:#282b33;--muted:#5e626d;--bg:#f4f5f7;--danger:#c0392b;--ok:#8a6712;--info:#2f6fb0;--warn:#b07d24;}
  :root[data-theme="light"] .notice{color:#6f520e}
  :root[data-theme="light"] .error{background:rgba(192,57,43,.08);border-color:var(--danger);color:#9c261b}
  :root[data-theme="light"] .status.pending,:root[data-theme="light"] .status.approved,
  :root[data-theme="light"] .status.booked,:root[data-theme="light"] .status.delivered,
  :root[data-theme="light"] .status.paid{background:rgba(200,150,30,.15);color:#7a5a10}
  :root[data-theme="light"] .status.under_review,:root[data-theme="light"] .status.dispatched,
  :root[data-theme="light"] .status.in_transit{background:rgba(47,111,176,.13);color:#255d95}
  :root[data-theme="light"] .status.needs_info{background:rgba(192,57,43,.1);color:#a3271b}
  :root[data-theme="light"] .status.invoiced{background:rgba(106,90,192,.13);color:#574aa6}
  :root[data-theme="light"] .status.rejected,:root[data-theme="light"] .status.available,
  :root[data-theme="light"] .status.cancelled{background:#eceef1;color:#5e626d}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
  a{color:var(--gold)}
  .stripe{height:4px;background:linear-gradient(90deg,var(--gold-600),var(--gold))}
  header.top{display:flex;align-items:center;gap:24px;padding:14px 22px;background:var(--black);border-bottom:1px solid var(--line)}
  header.top .brand{font-weight:800;letter-spacing:.5px}
  header.top .brand b{color:var(--gold)}
  header.top nav{display:flex;gap:18px;margin-left:8px}
  header.top nav a{color:var(--muted);text-decoration:none;font-weight:600;text-transform:uppercase;font-size:12px;letter-spacing:.4px}
  header.top nav a.active,header.top nav a:hover{color:var(--text)}
  header.top .who{margin-left:auto;display:flex;align-items:center;gap:14px;color:var(--muted);font-size:13px}
  header.top .who form{margin:0}
  .btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--panel);color:var(--text);
       padding:9px 15px;border-radius:8px;cursor:pointer;font:inherit;font-weight:600;text-decoration:none}
  .btn:hover{border-color:var(--gold)}
  .btn.gold{background:var(--gold-btn);border-color:var(--gold-btn);color:#1a1400}
  .btn.gold:hover{background:var(--gold-600)}
  .btn.sm{padding:6px 11px;font-size:12px}
  main{max-width:920px;margin:0 auto;padding:28px 22px 60px}
  h1{font-size:24px;margin:0 0 4px}
  h2{font-size:16px;margin:26px 0 12px}
  .sub{color:var(--muted);margin:0 0 22px}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  @media(max-width:640px){.grid{grid-template-columns:1fr}}
  .field{margin-bottom:14px}
  .field label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-bottom:5px}
  .field input,.field select{width:100%;background:var(--bg);border:1px solid var(--line);color:var(--text);padding:10px 12px;border-radius:8px;font:inherit}
  .status{display:inline-block;padding:4px 12px;border-radius:999px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.4px}
  .status.pending{background:rgba(224,176,96,.16);color:var(--warn)}
  .status.under_review{background:rgba(127,176,224,.16);color:var(--info)}
  .status.needs_info{background:rgba(224,85,85,.16);color:var(--danger)}
  .status.approved{background:rgba(220,181,85,.16);color:var(--gold)}
  .status.rejected{background:#23242b;color:var(--muted)}
  .status.available{background:#23242b;color:var(--muted)}
  .status.booked{background:rgba(220,181,85,.16);color:var(--gold)}
  .status.dispatched{background:rgba(127,176,224,.16);color:var(--info)}
  .status.in_transit{background:rgba(127,176,224,.22);color:#a9cdf0}
  .status.delivered{background:rgba(220,181,85,.16);color:var(--gold)}
  .status.invoiced{background:rgba(160,140,224,.16);color:#b0a0e0}
  .status.paid{background:rgba(220,181,85,.22);color:var(--gold)}
  .status.cancelled{background:#1c1d22;color:#6b6c74}
  .doc{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
  .doc:last-child{border-bottom:0}
  .doc .name{font-weight:600}
  .doc .meta{color:var(--muted);font-size:12px}
  .doc .review{margin-left:auto}
  .notice{background:rgba(220,181,85,.12);border:1px solid var(--gold-600);color:#eadfbf;padding:10px 14px;border-radius:8px;margin-bottom:16px}
  .error{background:rgba(224,85,85,.12);border:1px solid var(--danger);color:#f0bcbc;padding:10px 14px;border-radius:8px;margin-bottom:16px}
  .login-wrap{max-width:420px;margin:7vh auto 0}
  .muted{color:var(--muted)}
  .upload-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:12px 0;border-top:1px solid var(--line)}
  .upload-row .lbl{min-width:230px;font-weight:600}
  input[type=file]{color:var(--muted);font-size:13px}
  .icon-btn{background:none;border:1px solid var(--line);color:var(--muted);width:32px;height:32px;border-radius:8px;cursor:pointer;font-size:14px}
  .icon-btn:hover{color:var(--text);border-color:var(--gold)}
  .logo-black{display:none}
  :root[data-theme="light"] .logo-white{display:none}
  :root[data-theme="light"] .logo-black{display:inline-block}
</style>
<script>
  (function(){try{var t=localStorage.getItem('bsg-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
  function __toggleTheme(){var r=document.documentElement,n=r.getAttribute('data-theme')==='light'?'dark':'light';r.setAttribute('data-theme',n);try{localStorage.setItem('bsg-theme',n);}catch(e){}}
</script>
</head>
<body>
<div class="stripe"></div>
<% if (typeof carrier !== 'undefined' && carrier) { %>
<header class="top">
  <a href="/portal" class="brand" style="display:flex;align-items:center;gap:11px;text-decoration:none">
    <img class="logo-white" src="/brand/logo.png" alt="BSG Carriers" style="height:38px;width:auto">
    <img class="logo-black" src="/brand/logo-dark.png" alt="BSG Carriers" style="height:38px;width:auto">
    <span class="muted" style="font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.14em;padding-left:11px;border-left:1px solid var(--line)">Owner-Op Portal</span>
  </a>
  <nav>
    <a href="/portal" class="<%= (typeof active!=='undefined'&&active==='home')?'active':'' %>">Dashboard</a>
    <a href="/portal/loads" class="<%= (typeof active!=='undefined'&&active==='loads')?'active':'' %>">My Loads</a>
    <a href="/portal/invoices" class="<%= (typeof active!=='undefined'&&active==='invoices')?'active':'' %>">Invoices</a>
    <a href="/portal/profile" class="<%= (typeof active!=='undefined'&&active==='profile')?'active':'' %>">My Profile</a>
  </nav>
  <div class="who">
    <span><%= carrier.company_name %></span>
    <button class="icon-btn" type="button" title="Switch light / dark theme" aria-label="Switch light or dark theme" onclick="__toggleTheme()">🌓</button>
    <form method="post" action="/portal/logout"><input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>"><button class="btn sm" type="submit">Sign out</button></form>
  </div>
</header>
<% } %>
<main>
